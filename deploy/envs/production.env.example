# ── Kinexus HRMS – PRODUCTION environment ───────────────────────────────────
# Live tenants. Payroll, payslips, ID documents, appraisal ratings — treat
# every value here as a controlled secret.
#
# Real values live in the cloud secret store (Secrets Manager / Key Vault /
# Secret Manager) and the GitHub `production` Environment, which MUST carry a
# required-reviewer protection rule. This template documents the variable set
# only — do not create a filled prod.env on a developer machine.

ENVIRONMENT=production

# ── Image ───────────────────────────────────────────────────────────────────
# Promotion is BY DIGEST. This is the exact image that passed smoke and
# integration tests in `test`. Production never rebuilds.  (§14.1)
KINEXUS_IMAGE=ghcr.io/surbhigoyal7381-agent/hr-app:prod-REPLACE_ME

# ── Domain ──────────────────────────────────────────────────────────────────
BASE_DOMAIN=kinexus.in
# Requires:
#   • wildcard DNS   *.kinexus.in → load balancer
#   • wildcard TLS   *.kinexus.in (+ apex), DNS-01 validation
#   • the Host header preserved end-to-end — rewriting it breaks tenant
#     resolution for every tenant simultaneously.  (§7)

# ── Database (managed, Multi-AZ + read replica) ─────────────────────────────
DB_HOST=kinexus-prod.xxxxx.rds.amazonaws.com
DB_PORT=3306
DB_ROOT_USERNAME=kinexus_admin
DB_ROOT_PASSWORD=<secret store>
# 🔴 This credential creates databases and users. It belongs ONLY to the tenant
# provisioning worker, not to the general web tier. The web/worker containers
# should hold a least-privilege user with DML on existing site DBs.  (G11, §17)

# ── Redis: two instances with different policies ────────────────────────────
REDIS_CACHE=redis://kinexus-prod-cache.xxxxx.cache.amazonaws.com:6379
REDIS_QUEUE=redis://kinexus-prod-queue.xxxxx.cache.amazonaws.com:6379
# cache : maxmemory-policy=allkeys-lru, no persistence
# queue : maxmemory-policy=noeviction, AOF enabled, Multi-AZ  (§6.2)

# ── Application ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=<secret store — rotate after first login>
DEVELOPER_MODE=0
MUTE_EMAILS=0

# ── SMTP relay ──────────────────────────────────────────────────────────────
SMTP_HOST=<relay host>
SMTP_PORT=587
SMTP_USER=<secret store>
SMTP_PASSWORD=<secret store>

# ── TLS ─────────────────────────────────────────────────────────────────────
# Prefer terminating at the cloud LB with a managed wildcard certificate and
# deleting the 443 block from nginx.conf entirely.
TLS_CERT_DIR=/etc/letsencrypt/live/kinexus.in

# ── Backups ─────────────────────────────────────────────────────────────────
BACKUP_BUCKET=kinexus-prod-backups
BACKUP_REGION=ap-south-1
# Cross-region replication, versioning, SSE, 35-day retention.
# 🔴 A database dump alone is NOT a restorable backup. site_config.json holds
# the per-site encryption_key; without it, every stored credential in the
# restored site is undecryptable. Back them up together.  (§19)

# ── Smoke test target used by the deploy workflow ───────────────────────────
SMOKE_SITE=demo.kinexus.in
