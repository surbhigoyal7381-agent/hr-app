# ── Kinexus HRMS – DEV environment ──────────────────────────────────────────
# Deployed automatically from the `dev` branch.
#
# Purpose: integration of feature work, and the FIRST place the PMS module
# (37 doctypes that have never run — ARCHITECTURE.md §11) is exercised.
#
# Render this file on the host from the cloud secret store; never commit the
# filled copy. `deploy/envs/*.env` is gitignored.
#
# For day-to-day local coding, use the laptop stack instead:
#   cd hrms/docker && docker compose up -d      → http://hrms.localhost

ENVIRONMENT=dev

# ── Image (set by CI to dev-<sha>) ──────────────────────────────────────────
KINEXUS_IMAGE=ghcr.io/surbhigoyal7381-agent/hr-app:dev-REPLACE_ME

# ── Domain ──────────────────────────────────────────────────────────────────
BASE_DOMAIN=dev.kinexus.in
# Needs wildcard DNS *.dev.kinexus.in → load balancer.
SMOKE_SITE=demo.dev.kinexus.in

# ── Database (small managed instance, or a container on the same box) ───────
DB_HOST=<host>
DB_PORT=3306
DB_ROOT_USERNAME=kinexus_admin
DB_ROOT_PASSWORD=<from secret store>

# ── Redis (one instance is acceptable in dev) ───────────────────────────────
# ── Redis: the cache and the queue MUST NOT share a database ────────────────
# One redis instance backs both here, so the database number is what separates
# them: /0 cache, /1 queue. Leave the number off and BOTH land in database 0 -
# which is what the dev stack is running today (checked 2026-09-19). A cache
# flush then deletes queued jobs, and nobody is told. Always write the number.
REDIS_CACHE=redis://<host>:6379/0
REDIS_QUEUE=redis://<host>:6379/1

# ── Application ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=<from secret store>
DEVELOPER_MODE=1

# 🔴 Outbound email OFF. This app sends progress reminders, arrival
# notifications and compliance alerts on a daily scheduler tick. Any non-prod
# environment holding a copy of real data will email real employees and
# vendors within hours unless this stays 1.
MUTE_EMAILS=1

# ── TLS ─────────────────────────────────────────────────────────────────────
TLS_CERT_DIR=/etc/letsencrypt/live/dev.kinexus.in
