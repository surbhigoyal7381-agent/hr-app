# ── Grace Drinks HRMS – Production environment variables ──
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.
#
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env

# MariaDB root password  (used by both the DB container and bench site creation)
DB_ROOT_PASSWORD=change_this_to_a_strong_password_min16chars

# Frappe Administrator account password  (log in at http://<your-ip>/login)
ADMIN_PASSWORD=change_this_admin_password_min12chars
