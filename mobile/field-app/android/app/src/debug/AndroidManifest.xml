<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest fragment (slice 013: AC-166, SEC-16). The Android
  manifest merger combines this with android/app/src/main/AndroidManifest.xml
  for a debug build only - a pilot or release build is assembled from main/
  alone and never sees this file or the network config it points to.

  This adds exactly one thing to the merged manifest: which domains may use
  plain HTTP (network_security_config.xml, in this same source set). It does
  not repeat the permission list, application tag details or provider that
  live in main/ - the merger keeps those from main/ untouched.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
