# Python
*.pyc
__pycache__/
*.egg-info/

# Node / build artifacts
node_modules/
dist/
hrms/public/dist
hrms/public/node_modules

# Editors / OS
.DS_Store
*.swp
.vscode
.vs
tags

# Local DB dumps & site backups (contain credentials and employee data — keep local only)
docker/backups/
hrms/docker/backups/
*.sql.gz
*-site_config_backup.json

# Production credentials – NEVER commit the real .env
deploy/.env
deploy/server.env
deploy/envs/*.env
!deploy/envs/*.env.example
deploy/compose/.image.env
backups/

# Claude Code: keep the agent team in git (agents, shared context, skills).
# Ignore session data — worktrees (115 MB) and personal local settings.
.claude/*
!.claude/agents/
!.claude/context/
!.claude/skills/

# Logs
*debug.log
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

# Rendered pages the contrast checker writes out while it runs
scripts/_c_*.html

# ── Slice 015 (repo history scan, 2026-09-17) ────────────────────────────────
# Things that sit in the repo folder but must never be committed.

# Backups of the .claude folder: they hold settings.local.json and archives.
.claude.backup-*/

# Reference PDFs and manuals dropped in the repo root while working. Real
# third-party documents, so they stay out of git. Move them out of the folder
# if you want to keep them.
/*.pdf

# NOT ignored on purpose: docs/product/legal/ — those templates are meant to
# be committed once they are ready.
