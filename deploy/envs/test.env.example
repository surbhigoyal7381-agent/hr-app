# ── Kinexus HRMS – TEST (staging / UAT) environment ─────────────────────────
# Mirrors production TOPOLOGY at smaller scale. Same process split, same
# managed services, smaller instances. A staging environment that runs a
# different process model does not de-risk anything.
#
# Real values belong in the GitHub `test` Environment secrets, not in a file
# on disk. This template documents the required variable set.

ENVIRONMENT=test

# ── Image ───────────────────────────────────────────────────────────────────
# Set by CI to the digest built from the merge commit. Never `latest`.
KINEXUS_IMAGE=ghcr.io/surbhigoyal7381-agent/hr-app:test-REPLACE_ME

# ── Domain ──────────────────────────────────────────────────────────────────
BASE_DOMAIN=test.kinexus.in
# Requires wildcard DNS *.test.kinexus.in → load balancer.
# Synthetic tenants: acme.test.kinexus.in, globex.test.kinexus.in

# ── Database (managed, single-AZ) ───────────────────────────────────────────
DB_HOST=kinexus-test.xxxxx.rds.amazonaws.com
DB_PORT=3306
DB_ROOT_USERNAME=kinexus_admin
DB_ROOT_PASSWORD=<from secret store>
# Parameter group must set: character_set_server=utf8mb4,
# collation_server=utf8mb4_unicode_ci, innodb_file_per_table=1,
# skip_innodb_read_only_compressed=1, max_connections>=250.  (§6.1)

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_CACHE=redis://kinexus-test-cache.xxxxx.cache.amazonaws.com:6379
REDIS_QUEUE=redis://kinexus-test-queue.xxxxx.cache.amazonaws.com:6379
# Queue instance: maxmemory-policy=noeviction + AOF. Evicting queued jobs
# silently drops appraisal notifications and tenant provisioning runs.  (§6.2)

# ── Application ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=<from secret store — must differ from production>
DEVELOPER_MODE=0

# 🔴 Test data is an ANONYMISED restore of a production backup. Email must go
# to a mail-catcher (Mailpit/MailHog), never to a real relay. Set this BEFORE
# the first restore, not after — the scheduler fires within minutes.  (§13)
MUTE_EMAILS=1
SMTP_HOST=mailpit
SMTP_PORT=1025

# ── TLS ─────────────────────────────────────────────────────────────────────
TLS_CERT_DIR=/etc/letsencrypt/live/test.kinexus.in

# ── Smoke test target used by the deploy workflow ───────────────────────────
SMOKE_SITE=acme.test.kinexus.in
