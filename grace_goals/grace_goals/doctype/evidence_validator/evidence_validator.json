   "options": "<div style=\"background:#f4f5f6;border:1px solid #d1d8dd;border-radius:4px;padding:14px 16px;font-size:12.5px;line-height:1.6\"><p style=\"margin:0 0 10px\"><strong>Available variables for validator_logic</strong> &mdash; all keys are optional. Omit any key to skip that check (defaults apply only to keys not present in the JSON).</p><table style=\"width:100%;border-collapse:collapse\"><thead><tr style=\"background:#e8eaed\"><th style=\"padding:6px 8px;text-align:left;border:1px solid #ccc\">Key</th><th style=\"padding:6px 8px;text-align:left;border:1px solid #ccc\">Type</th><th style=\"padding:6px 8px;text-align:left;border:1px solid #ccc\">Applies to</th><th style=\"padding:6px 8px;text-align:left;border:1px solid #ccc\">Description</th><th style=\"padding:6px 8px;text-align:left;border:1px solid #ccc\">Default</th></tr></thead><tbody><tr><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>min_amount</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Number</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Invoice, Sales Order</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Minimum document value (INR). Evidence below this is rejected.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">0</td></tr><tr style=\"background:#fafafa\"><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>max_amount</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Number</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Invoice, Sales Order</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Maximum document value. Omit for no upper cap.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">No limit</td></tr><tr><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>max_age_days</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Integer</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Invoice only</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Maximum days since the document date. Older invoices are rejected.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">90</td></tr><tr style=\"background:#fafafa\"><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>min_order_count</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Integer</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Sales Order only</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Minimum number of orders in the submission.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">1</td></tr><tr><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>max_order_count</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Integer</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Sales Order only</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Maximum number of orders. Omit for no upper cap.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">No limit</td></tr><tr style=\"background:#fafafa\"><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>min_volume</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Number</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Sales Order only</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Minimum physical quantity (in the unit specified on the evidence). E.g. 500 for 500 Liters.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">0</td></tr><tr><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>max_volume</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Number</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Sales Order only</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Maximum physical quantity. Omit for no upper cap.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">No limit</td></tr><tr style=\"background:#fafafa\"><td style=\"padding:5px 8px;border:1px solid #ddd\"><code>allowed_volume_units</code></td><td style=\"padding:5px 8px;border:1px solid #ddd\">Array</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Sales Order only</td><td style=\"padding:5px 8px;border:1px solid #ddd\">Accepted unit values. Evidence with any other unit is rejected. Omit to accept all units.</td><td style=\"padding:5px 8px;border:1px solid #ddd\">All units</td></tr></tbody></table><p style=\"margin:12px 0 4px\"><strong>Sales Order example</strong> &mdash; at least 3 orders, minimum 200 Liters or Kg, minimum INR 5,000:</p><pre style=\"background:#fff;border:1px solid #ccc;padding:8px;border-radius:3px;margin:0\">{&quot;min_order_count&quot;: 3, &quot;min_volume&quot;: 200, &quot;allowed_volume_units&quot;: [&quot;Liters&quot;, &quot;Kg&quot;], &quot;min_amount&quot;: 5000}</pre><p style=\"margin:12px 0 4px\"><strong>Invoice example</strong> &mdash; must be within 30 days and at least INR 10,000:</p><pre style=\"background:#fff;border:1px solid #ccc;padding:8px;border-radius:3px;margin:0\">{&quot;max_age_days&quot;: 30, &quot;min_amount&quot;: 10000}</pre></div>"
